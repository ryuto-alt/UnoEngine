<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros" />
  
  <!-- ========================================
       External Libraries Include Paths
       外部ライブラリのインクルードパス設定
       ======================================== -->
  <PropertyGroup>
    <ExternalIncludePath>$(ProjectDir)external\DirectX-Headers\include</ExternalIncludePath>
  </PropertyGroup>
  
  <!-- ========================================
       C/C++ Settings
       C/C++コンパイラ設定
       ======================================== -->
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(ExternalIncludePath);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  
  <ItemGroup />
</Project>
